{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sca v1",
  "description": "Known vulnerabilities in the dependencies of a commit",
  "type": "object",
  "additionalProperties": false,
  "required": ["result", "commit", "scanner", "database", "target", "failOn", "summary", "findings"],
  "properties": {
    "result": {"enum": ["pass", "fail"], "description": "fail when any finding is at or above failOn"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "scanner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "database": {
      "type": "object",
      "description": "The vulnerability database the scan used",
      "additionalProperties": false,
      "required": ["built", "schemaVersion"],
      "properties": {
        "built": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T"},
        "schemaVersion": {"type": "string"}
      }
    },
    "target": {"type": "string", "pattern": "^(dir|sbom):.", "description": "What was scanned, as the pipeline asked"},
    "failOn": {"enum": ["critical", "high", "medium", "low", "negligible"]},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical", "high", "medium", "low", "negligible", "unknown"],
      "properties": {
        "critical": {"type": "integer"},
        "high": {"type": "integer"},
        "medium": {"type": "integer"},
        "low": {"type": "integer"},
        "negligible": {"type": "integer"},
        "unknown": {"type": "integer"}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "aliases", "severity", "package", "fixedIn", "fixState", "locations"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "severity": {"enum": ["critical", "high", "medium", "low", "negligible", "unknown"]},
          "package": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "type", "purl"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "version": {"type": "string"},
              "type": {"type": "string"},
              "purl": {"type": "string"}
            }
          },
          "fixedIn": {"type": "array", "items": {"type": "string"}},
          "fixState": {"enum": ["fixed", "not-fixed", "wont-fix", "unknown"]},
          "locations": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
