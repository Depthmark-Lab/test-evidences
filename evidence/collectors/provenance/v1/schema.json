{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "provenance v1",
  "description": "SLSA build provenance v1 (https://slsa.dev/provenance/v1) with GitHub's workflow build type: which workflow, commit and run produced an artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["buildDefinition", "runDetails"],
  "properties": {
    "buildDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["buildType", "externalParameters", "internalParameters", "resolvedDependencies"],
      "properties": {
        "buildType": {"const": "https://actions.github.io/buildtypes/workflow/v1"},
        "externalParameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workflow"],
          "properties": {
            "workflow": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ref", "repository", "path"],
              "properties": {
                "ref": {"type": "string", "pattern": "^refs/"},
                "repository": {"type": "string", "pattern": "^https://"},
                "path": {"type": "string", "pattern": "^\\.github/workflows/[^/]+\\.ya?ml$"}
              }
            }
          }
        },
        "internalParameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["github"],
          "properties": {
            "github": {
              "type": "object",
              "additionalProperties": false,
              "required": ["event_name", "repository_id", "repository_owner_id", "runner_environment"],
              "properties": {
                "event_name": {"type": "string", "minLength": 1},
                "repository_id": {"type": "string", "pattern": "^[0-9]+$"},
                "repository_owner_id": {"type": "string", "pattern": "^[0-9]+$"},
                "runner_environment": {"enum": ["github-hosted", "self-hosted"]}
              }
            }
          }
        },
        "resolvedDependencies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["uri", "digest"],
            "properties": {
              "uri": {"type": "string", "pattern": "^git\\+https://"},
              "digest": {
                "type": "object",
                "additionalProperties": false,
                "required": ["gitCommit"],
                "properties": {"gitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}
              }
            }
          }
        }
      }
    },
    "runDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["builder", "metadata"],
      "properties": {
        "builder": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {"id": {"type": "string", "pattern": "^https://[^@]+/\\.github/workflows/[^/@]+\\.ya?ml@refs/"}}
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["invocationId"],
          "properties": {"invocationId": {"type": "string", "pattern": "^https://.+/actions/runs/[0-9]+/attempts/[0-9]+$"}}
        }
      }
    }
  }
}
